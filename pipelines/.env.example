# =============================================================
# Speech Analytics pipelines configuration — Aurélia
# Rename to .env and adjust the values for your workspace.
# =============================================================

# --- Unity Catalog ---
# Catalog and schema where everything is created (volume, tables, models).
CATALOG=field_toolbox_catalog
SCHEMA=aurelia_speech

# --- Audio landing volume ---
# Unity Catalog volume where the audio files (.mp3 / .wav) land.
# Created by the 00_setup_env.py notebook if it doesn't exist.
VOLUME_LANDING=audio_landing

# --- Whisper endpoint ---
# Model Serving endpoint running Whisper Large V3 Turbo (scale-to-zero).
# Schema: input = {"inputs":["<base64_audio>"]}, output = {"predictions":["<text>"]}
WHISPER_ENDPOINT=aurelia-whisper-turbo

# --- LLM endpoint for the analysis ---
# Foundation Model API. Good options for PT-BR:
#   - databricks-claude-sonnet-4-6  (most capable, recommended)
#   - databricks-claude-haiku-4-5   (cheaper, fast)
#   - databricks-meta-llama-3-3-70b-instruct (open weights)
LLM_ENDPOINT=databricks-claude-sonnet-4-6

# --- Tables (filled in automatically; only change them if you want custom names) ---
TABLE_BRONZE=bronze_audio_files_imperativo
TABLE_SILVER=silver_transcripts
TABLE_GOLD=gold_call_insights

# --- ai_transcribe version (imperative/02b_silver_ai_transcribe.py) ---
# Separate silver and gold tables, so both versions coexist and can be compared.
TABLE_SILVER_AIT=silver_transcripts_ait
TABLE_GOLD_AIT=gold_call_insights_ait
